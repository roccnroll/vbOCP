# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc

# Dati generati (rigenerabili dal codice)
data/meshes/*
data/snapshots/*
!data/meshes/.gitkeep
!data/snapshots/.gitkeep

# PODNN: eccezione sui pesi allenati (train_reduced_nn.py) - rigenerarli richiede tempo di
# training, a differenza di basi POD/snapshot/CSV di sweep che restano ignorati
!data/snapshots/*_nn.pt
!data/snapshots/*_nn.norm.npz

# eccezione: mesh usata da configs/test1.yaml, tenuta nel repo (~1.5MB) cosi'
# non serve rigenerarla (script di generazione non e' un CLI legato al config)
!data/meshes/test1_uniform_corner_refined_ctrl/
!data/meshes/test1_uniform_corner_refined_ctrl/*.csv

# GNN: .mat generati da convert_to_gca_rom.py (rigenerabili dagli snapshot) - NON i
# pesi allenati in data/gnn/models/, quelli si tengono nel repo (~40 min di training)
data/gnn/*.mat

# repo esterna gca-rom (clonata dal notebook dentro la repo, ~500MB) - mai committarla
/gca-rom/

# Ambienti virtuali
.venv/
venv/

# Output generati da notebook/script (plot, immagini)
notebooks/output/
notebooks/*.png
